@model List<KhoaEntity>
@{
    ViewData["Title"] = "Quản lý khoa";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .khoa-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .khoa-title {
        font-size: 26px;
        font-weight: 700;
        color: #2c3e50;
    }

    .btn-add {
        background-color: #228be6;
        color: #fff;
        padding: 10px 18px;
        font-weight: 600;
        border-radius: 6px;
        text-decoration: none;
        transition: 0.2s;
    }

        .btn-add:hover {
            background-color: #1c7ed6;
        }

    .table-wrapper {
        background: #fff;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 0 16px rgba(0,0,0,0.05);
    }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 15px;
    }

        .custom-table th, .custom-table td {
            border: 1px solid #dee2e6;
            padding: 12px;
            vertical-align: middle;
        }

        .custom-table th {
            background: #f1f5fb;
            font-weight: 600;
            text-align: center;
        }

        .custom-table td {
            background: #fff;
        }

    .btn-action {
        padding: 6px 12px;
        border-radius: 5px;
        font-weight: 500;
        font-size: 14px;
        text-decoration: none;
        color: #fff;
        margin-right: 5px;
        transition: 0.2s;
    }

    .btn-edit {
        background-color: #40c057;
    }

        .btn-edit:hover {
            background-color: #37b24d;
        }

    .btn-delete {
        background-color: #fa5252;
    }

        .btn-delete:hover {
            background-color: #f03e3e;
        }
</style>

<div class="container-fluid px-4">
    <div class="khoa-header">
        <div class="khoa-title">Quản lý Khoa</div>
        <a href="/Khoa/Create" class="btn-add">+ Thêm Khoa</a>
    </div>

    <div class="table-wrapper">
        <table class="custom-table">
            <thead>
                <tr>
                    <th style="width: 60px;">ID</th>
                    <th>Tên khoa</th>
                    <th style="width: 180px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.Id</td>
                            <td>@item.TenKhoa</td>
                            <td class="text-center">
                                <a href="/Khoa/Create?id=@item.Id" class="btn-action btn-edit">Sửa</a>
                                <a href="/Khoa/Delete?id=@item.Id" class="btn-action btn-delete" onclick="return confirm('Bạn chắc chắn muốn xóa khoa này?');">Xóa</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted fst-italic">Không có khoa nào được tìm thấy.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
