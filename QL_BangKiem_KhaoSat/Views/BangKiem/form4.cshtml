@{
    ViewData["Title"] = "Form 4 - Bảng Kiểm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .a4-container {
        background: white;
        width: 794px;
        min-height: 1123px;
        margin: 0 auto;
        margin-top: 20px;
        padding: 20px 15px;
        box-sizing: border-box;
        box-shadow: 0 0 10px rgba(0,0,0,0.2);
        position: relative;
    }

    .logo {
        width: 308px;
        height: 52px;
        background: #e0e0e0;
        font-weight: bold;
        font-size: 18px;
        line-height: 52px;
        text-align: center;
        margin-bottom: 5px;
    }

    .date {
        position: relative;
        width: 341px;
        height: 24px;
        float: right;
        font-size: 14px;
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }

        .date input[type="date"] {
            margin-left: 8px;
            flex: 1;
            padding: 4px 6px;
            font-size: 14px;
        }

    .department {
        position: relative;
        width: 219px;
        height: 29px;
        float: left;
        font-size: 14px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
    }

        .department input[type="text"] {
            margin-left: 8px;
            flex: 1;
            padding: 4px 6px;
            font-size: 14px;
        }

    .nurse {
        position: relative;
        width: 338px;
        height: 29px;
        float: right;
        font-size: 14px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
    }

        .nurse input[type="text"] {
            margin-left: 8px;
            flex: 1;
            padding: 4px 6px;
            font-size: 14px;
        }

    .clear-fix {
        clear: both;
    }

    .title {
        text-align: center;
        font-weight: bold;
        font-size: 18px;
        margin-bottom: 20px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
        table-layout: fixed;
        word-wrap: break-word;
    }

    th, td {
        border: 1px solid #000;
        padding: 6px 8px;
        text-align: center;
        vertical-align: middle;
    }

    th {
        background: #eee;
    }

    tbody tr:nth-child(even) {
        background: #f9f9f9;
    }

    tbody td:nth-child(2) {
        text-align: left;
        padding-left: 10px;
    }

    input[type="radio"] {
        width: 100%;
        height: 100%;
        margin: 0;
        display: block;
        cursor: pointer;
    }

    .ddtk-label {
        margin-top: 30px;
        text-align: right;
        font-weight: bold;
        font-size: 14px;
    }

    table, tr, td, th {
        page-break-inside: avoid !important;
    }

    thead {
        display: table-header-group;
    }

    tfoot {
        display: table-footer-group;
    }

    .radio-column {
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: 14px;
        line-height: 1.4;
    }

        .radio-column label {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .radio-column input[type="radio"] {
            width: 16px;
            height: 16px;
            margin: 0;
        }

</style>
<div class="a4-container" id="capture">
    <div class="logo">
        <a href="https://benhvienungbuou.vn/" target="_blank">
            <img src="https://benhvienungbuou.vn/wp-content/uploads/2022/12/Mask-group-2022-12-27T141100.572.png" alt="Logo" style="height: 52px; width: auto;">
        </a>
    </div>
    <div class="date">Ngày giám sát: <input type="date" /></div>
    <div class="clear-fix"></div>

    <div class="department">
        Khoa:
        <select id="selectKhoa">
            <option value="">-- Chọn khoa --</option>
        </select>
    </div>

    <div class="nurse">Điều dưỡng thực hiện: <input type="text" /></div>
    <div class="clear-fix"></div>

    <div class="title">
        <input id="inputTitle" type="text"
               placeholder="📋 Nhập tên bảng kiểm..."
               style="width:100%;font-size:24px;font-weight:bold;text-align:center;border:none;outline:none;background:transparent;color:#2c3e50;" />
    </div>

    <!-- Bảng kiểm -->
    <table border="1" cellspacing="0" cellpadding="5">
        <thead>
            <tr>
                <th rowspan="2" style="width:6%;">STT</th>
                <th rowspan="2" style="width:35%;">Các bước tiến hành</th>
                <th colspan="3" style="width:29%; text-align:center;">
                    NVYT Thực hiện
                    <br>
                    <input type="text" placeholder="Nhập ghi chú..." style="width:90%; margin-top:4px;">
                </th>
                <th colspan="3" style="width:29%; text-align:center;">
                    NVYT Thực hiện
                    <br>
                    <input type="text" placeholder="Nhập ghi chú..." style="width:90%; margin-top:4px;">
                </th>
            </tr>
            <tr style="text-align:center;">
                <th>Thực hiện đầy đủ (1đ)</th>
                <th>Thực hiện chưa đạt (0.5đ)</th>
                <th>Không thực hiện (0đ)</th>
                <th>Thực hiện đầy đủ (1đ)</th>
                <th>Thực hiện chưa đạt (0.5đ)</th>
                <th>Không thực hiện (0đ)</th>
            </tr>
        </thead>
        <tbody id="table-body"></tbody>
    </table>

    <div class="ddtk-label">Giám sát viên</div>
    <div style="margin-top: 80px; font-size: 13px; line-height: 1.5;">
        <strong>Lưu ý:</strong><br>
        Một số ghi chú:<br>
        + NVYT sử dụng câu hỏi mở (với thông tin: họ tên, năm sinh/ tuổi, địa chỉ) và kiểm tra lại sau khi NB/ thân nhân trả lời;<br>
        + Yếu tố giới tính không áp dụng tại: Phòng khám tuyến vú, phụ khoa;<br>
        &nbsp;&nbsp;&nbsp;&nbsp;Khoa Ngoại tuyến vú, Ngoại phụ khoa, Xạ trị phụ khoa;<br>
        + Yếu tố địa chỉ: Phải đầy đủ 3 cấp thông tin cư trú (xã/phường/thị trấn, quận/huyện/thành phố/tỉnh);<br>
        Sau khi đánh giá chi tiết từng yếu tố đính kèm của mục 1 (đúng người bệnh) → tiến hành kết luận nội dung “đúng người bệnh” như sau:<br>
        “Đạt”: khi ít nhất 3 yếu tố được đánh giá ở cột “thực hiện đầy đủ - 1đ”;<br>
        “Chưa đạt”: khi đánh giá ít hơn 3 yếu tố; hoặc khi đánh giá từ 3 yếu tố trở lên nhưng chỉ có 2 yếu tố ở cột “thực hiện đầy đủ - 1đ”;<br>
        “Không đạt”: khi tiếp xúc người bệnh mà không xác nhận lại thông tin của người bệnh;<br>
        Các nội dung còn lại đánh giá theo thang điểm có sẵn.
    </div>
</div>
<div style="display: flex; justify-content: center; gap: 15px; margin-top: 30px;">
    <button onclick="saveFormBangKiem()" class="btn btn-primary">
        <i class="fas fa-save"></i> Lưu phiếu kiểm
    </button>
    <button onclick="saveAsImage()" class="btn btn-success">
        <i class="fas fa-image"></i> Xuất ảnh
    </button>
    <a href="/Step/Index?formKey=Form4" class="btn btn-info">
        <i class="fas fa-plus"></i> Thêm bước
    </a>
</div>

<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script>
    const steps = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Steps));
    const tableBody = document.getElementById('table-body');
    tableBody.innerHTML = '';

    // Sub-steps cho bước đầu tiên (giống form3)
    const subSteps = [
        "a. Họ tên người bệnh",
        "b. Năm sinh / tuổi",
        "c. Địa chỉ",
        "d. Giới tính",
        "e. Mã số người bệnh"
    ];

    steps.forEach((step, index) => {
        if (index === 0) {
            // Dòng chính step 1
            const mainRow = document.createElement('tr');
                // Sửa lại mainRow (radio dòng chính):
    mainRow.innerHTML = `
        <td style="text-align:center;">${index + 1}</td>
        <td>${step}</td>
        <td colspan="3" style="padding-left: 10px; vertical-align: top;">
            <div class="radio-column">
                <label><input type="radio" name="step${index}-nvyt1" value="1"> Đạt</label>
                <label><input type="radio" name="step${index}-nvyt1" value="0"> Không đạt</label>
                <label><input type="radio" name="step${index}-nvyt1" value="0.5"> Chưa đạt</label>
            </div>
        </td>
        <td colspan="3" style="padding-left: 10px; vertical-align: top;">
            <div class="radio-column">
                <label><input type="radio" name="step${index}-nvyt2" value="1"> Đạt</label>
                <label><input type="radio" name="step${index}-nvyt2" value="0"> Không đạt</label>
                <label><input type="radio" name="step${index}-nvyt2" value="0.5"> Chưa đạt</label>
            </div>
        </td>
    `;

            tableBody.appendChild(mainRow);

            // Dòng substeps
            subSteps.forEach((sub, subIndex) => {
                const subRow = document.createElement('tr');
                subRow.innerHTML = `
                    <td></td>
                    <td>${sub}</td>
                    <td><input type="radio" name="step${index}-nvyt1-sub${subIndex}" value="1"></td>
                    <td><input type="radio" name="step${index}-nvyt1-sub${subIndex}" value="0.5"></td>
                    <td><input type="radio" name="step${index}-nvyt1-sub${subIndex}" value="0"></td>
                    <td><input type="radio" name="step${index}-nvyt2-sub${subIndex}" value="1"></td>
                    <td><input type="radio" name="step${index}-nvyt2-sub${subIndex}" value="0.5"></td>
                    <td><input type="radio" name="step${index}-nvyt2-sub${subIndex}" value="0"></td>
                `;
                tableBody.appendChild(subRow);
            });
            fetch('/Khoa/GetAll')
    .then(res => res.json())
    .then(data => {
        console.log(data);
        let html = '<option value="">-- Chọn khoa --</option>';
        data.forEach(khoa => {
            html += `<option value="${khoa.tenKhoa}">${khoa.tenKhoa}</option>`;
        });
        document.getElementById('selectKhoa').innerHTML = html;
    });
        } else {
            const mainRow = document.createElement('tr');
            mainRow.innerHTML = `
                <td style="text-align:center;">${index + 1}</td>
                <td>${step}</td>
                <td><input type="radio" name="step${index}-nvyt1" value="1"></td>
                <td><input type="radio" name="step${index}-nvyt1" value="0.5"></td>
                <td><input type="radio" name="step${index}-nvyt1" value="0"></td>
                <td><input type="radio" name="step${index}-nvyt2" value="1"></td>
                <td><input type="radio" name="step${index}-nvyt2" value="0.5"></td>
                <td><input type="radio" name="step${index}-nvyt2" value="0"></td>
            `;
            tableBody.appendChild(mainRow);
        }
    });

    function saveAsImage() {
        const element = document.getElementById("capture");
        html2canvas(element, {
            scale: 2,
            useCORS: true
        }).then(canvas => {
            const link = document.createElement("a");
            link.download = 'bang_kiem_form4.png';
            link.href = canvas.toDataURL('image/png');
            link.click();
        });
    }
    function gatherFormBangKiemData() {
        // Lấy thông tin chung
        var data = {
            Title: document.getElementById('inputTitle').value || "",
            TenForm: '@ViewData["Title"]',
            NgayGiamSat: document.querySelector('input[type="date"]')?.value || "",
            Khoa: document.getElementById('selectKhoa').value,
            DieuDuongThucHien: document.querySelector('.nurse input')?.value || "",
            NguoiGiamSat: document.querySelector('.ddtk-label')?.innerText || "",
            GhiChu: "", // Có thể bổ sung ghi chú nếu có
            Note: "",
            NhomThaoTacJson: "",
            KetQua: []
        };

        // Xử lý các bước (steps)
        var stepRows = document.querySelectorAll("#table-body tr");
        var stepIndex = 0;
        for (let i = 0; i < stepRows.length; ) {
            let tds = stepRows[i].querySelectorAll('td');
            if (tds.length > 1 && tds[0].innerText.trim() !== "") {
                // Dòng step chính
                stepIndex++;
                let stepName = tds[1].innerText.trim();

                // Nếu là step đầu tiên (có substep)
                if (stepIndex === 1) {
                    // Lấy giá trị radio của dòng chính (Đạt/Chưa đạt/Không đạt)
                    let ketqua1 = document.querySelector('input[name="step0-nvyt1"]:checked')?.value || null;
                    let ketqua2 = document.querySelector('input[name="step0-nvyt2"]:checked')?.value || null;

                    // Xử lý substep cho step đầu
                    let subSteps = [];
                    for (let sub = 1; sub <= 5; sub++) {
                        let subTds = stepRows[i + sub].querySelectorAll('td');
                        let subName = subTds[1].innerText.trim();

                        let diem1 = document.querySelector('input[name="step0-nvyt1-sub' + (sub - 1) + '"]:checked')?.value || null;
                        let diem2 = document.querySelector('input[name="step0-nvyt2-sub' + (sub - 1) + '"]:checked')?.value || null;

                        subSteps.push({
                            SubStepName: subName,
                            KetQuaNhom1: diem1,
                            KetQuaNhom2: diem2,
                            Diem: null // hoặc parseFloat nếu muốn
                        });
                    }

                    data.KetQua.push({
                        StepIndex: stepIndex,
                        StepName: stepName,
                        KetQuaLoai: "Radio",
                        KetQuaNhom1: ketqua1,
                        KetQuaNhom2: ketqua2,
                        Diem: null,
                        LoaiKetQua: "",
                        SubSteps: subSteps
                    });

                    i += 6; // Bỏ qua 1 dòng chính + 5 dòng sub
                } else {
                    // Các step còn lại
                    let ketqua1 = null, ketqua2 = null;
                    ketqua1 = stepRows[i].querySelector('input[name="step' + (stepIndex - 1) + '-nvyt1"]:checked')?.value || null;
                    ketqua2 = stepRows[i].querySelector('input[name="step' + (stepIndex - 1) + '-nvyt2"]:checked')?.value || null;

                    data.KetQua.push({
                        StepIndex: stepIndex,
                        StepName: stepName,
                        KetQuaLoai: "Radio",
                        KetQuaNhom1: ketqua1,
                        KetQuaNhom2: ketqua2,
                        Diem: null,
                        LoaiKetQua: "",
                        SubSteps: []
                    });

                    i++; // Tiếp tục dòng tiếp theo
                }
            } else {
                i++; // Skip dòng rỗng/substep
            }
        }
        return data;
    }

    function saveFormBangKiem() {
        var data = gatherFormBangKiemData();
            fetch('/api/BangKiem/SaveBangKiem', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    })
    .then(response => {
        if (!response.ok) return response.text().then(text => { throw new Error(text); });
        return response.json();
    })
    .then(result => {
        if (result.success) {
            alert('Lưu phiếu kiểm thành công!');
        } else {
            alert('Có lỗi khi lưu phiếu kiểm!');
        }
    })
    .catch(err => {
        alert('Lỗi gửi dữ liệu: ' + err);
        console.error(err);
    });

    }

</script>


