@model QL_BangKiem_KhaoSat.Models.StepEntity
@{
    ViewData["Title"] = "Thêm Bước";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var formKey = ViewBag.FormKey as string ?? "Form1";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<style>
    .ds-container {
        width: 85vw;
        max-width: 850px;
        margin: 40px auto;
        padding: 30px 34px;
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 2px 18px rgba(0,0,0,0.08);
    }

    .ds-title {
        font-size: 24px;
        font-weight: 700;
        color: #264d99;
        text-align: center;
        margin-bottom: 28px;
    }

    .form-group label {
        font-weight: 600;
    }

    .form-check {
        margin-top: 12px;
    }
</style>

<div class="ds-container">
    <div class="ds-title">Thêm bước cho @formKey</div>
    <form asp-action="Create" method="post">
        <input type="hidden" name="FormKey" value="@formKey" />

        <div class="form-group mb-3">
            <label>Nhập nhiều bước (dòng cách dòng):</label>
            <textarea name="MultipleSteps" class="form-control" rows="6" placeholder="Bạn có thể nhập nhiều dòng, mỗi dòng tương ứng một bước. Hệ thống sẽ tự đánh số."></textarea>
            <small class="text-muted">Hệ thống sẽ tự động đánh số bước theo thứ tự.</small>
        </div>

        <div class="form-group mb-3">
            <label>Hoặc thêm một bước riêng lẻ:</label>
            <input type="number" class="form-control mb-2" name="StepIndex" placeholder="Thứ tự bước" />
            <input type="text" class="form-control" name="StepName" placeholder="Nội dung bước" />
        </div>

        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" name="IsActive" id="IsActive" checked>
            <label class="form-check-label" for="IsActive">
                Hiển thị bước (nếu không chọn sẽ ẩn)
            </label>
        </div>

        <div class="d-flex gap-2 justify-content-end">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Lưu</button>
            <a href="@Url.Action("Index", new { formKey = formKey })" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Quay lại</a>
        </div>
    </form>
</div>
