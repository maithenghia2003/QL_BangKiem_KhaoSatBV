@model List<KhoaEntity>
@{
    ViewData["Title"] = "Danh sách khoa";
}
<style>
    .a4-container {
        background: #fff;
        max-width: 750px;
        margin: 40px auto;
        border-radius: 12px;
        box-shadow: 0 0 14px 0 rgba(44,62,80,.09);
        padding: 30px 20px;
        font-size: 16px;
    }

    .table-title {
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 20px;
        text-align: center;
    }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 15px;
    }

        .custom-table th, .custom-table td {
            border: 1px solid #dee2e6;
            padding: 10px 12px;
            text-align: left;
        }

        .custom-table th {
            background: #f4f6fb;
            font-weight: 600;
            text-align: center;
        }

        .custom-table tr:nth-child(even) {
            background: #f8fafc;
        }

    .btn-action {
        padding: 6px 14px;
        border-radius: 5px;
        font-size: 15px;
        font-weight: 600;
        margin-right: 4px;
        text-decoration: none;
        color: #fff;
    }

    .btn-edit {
        background: #3bc9db;
    }

    .btn-delete {
        background: #fa5252;
    }

    .btn-add {
        background: #228be6;
        color: #fff;
        border-radius: 5px;
        padding: 8px 18px;
        font-weight: 600;
        text-decoration: none;
        margin-bottom: 18px;
        display: inline-block;
    }
</style>
<div class="a4-container">
    <div class="table-title">
        Danh sách Khoa
    </div>
    <a href="/Khoa/Create" class="btn-add">+ Thêm Khoa</a>
    <table class="custom-table">
        <thead>
            <tr>
                <th style="width:50px">ID</th>
                <th style="width:300px">Tên khoa</th>
                <th style="width:160px">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="text-align:center">@item.Id</td>
                    <td>@item.TenKhoa</td>
                    <td style="text-align:center">
                        <a href="/Khoa/Create?id=@item.Id" class="btn-action btn-edit">Sửa</a>
                        <a href="/Khoa/Delete?id=@item.Id" class="btn-action btn-delete" onclick="return confirm('Xóa khoa này?');">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
