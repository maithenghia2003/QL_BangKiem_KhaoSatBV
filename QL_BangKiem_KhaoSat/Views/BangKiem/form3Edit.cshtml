@model QL_BangKiem_KhaoSat.Models.BangKiemEntity
@{
    ViewData["Title"] = "Sửa Form 3 - Bảng Kiểm";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var steps = Model.KetQua?.ToList() ?? new List<QL_BangKiem_KhaoSat.Models.BangKiemStepResult>();
    var khoaList = ViewBag.KhoaList as List<QL_BangKiem_KhaoSat.Models.KhoaEntity> ?? new List<QL_BangKiem_KhaoSat.Models.KhoaEntity>();
    var thaoTacList = new List<string>();
    if (!string.IsNullOrEmpty(Model.NhomThaoTacJson))
    {
        try
        {
            thaoTacList = System.Text.Json.JsonSerializer.Deserialize<List<string>>(Model.NhomThaoTacJson);
        }
        catch { thaoTacList = new List<string>(); }
    }
    // Danh sách tiêu chí cho Thời điểm đánh giá
    var tatCaTieuChi = new List<string>
    {
        "1.1 Tiếp nhận NB đăng ký khám bệnh", "1.2 Tư vấn",
        "2.1 Thanh toán viện phí", "2.2 Thu phí cận lâm sàng",
        "3.1 Cấp phát thuốc", "3.2 Cấp phát toa thuốc", "3.3 Cấp phiếu hẹn",
        "4.1 Thực hiện cận lâm sàng", "4.2 Cấp phát chỉ định cận lâm sàng", "4.3 Trả kết quả CLS",
        "5.1 Thực hiện kỹ thuật", "5.2 Thực hiện thủ thuật", "5.3 Thực hiện phẫu thuật", "5.4 Thực hiện CLS",
        "6.1 Nhập viện", "6.2 Chuyển khoa", "6.3 Chuyển viện", "6.4 Xuất viện"
    };
    var ghiChu = Model.Note ?? Model.GhiChu ?? "";
    bool isReuse = ViewBag.IsReuse == true;
}
<style>
    .a4-container {
        background: white;
        width: 794px;
        min-height: 1123px;
        margin: 0 auto;
        margin-top: 20px;
        padding: 20px 15px;
        box-sizing: border-box;
        box-shadow: 0 0 10px rgba(0,0,0,0.2);
        position: relative;
    }

    .logo {
        width: 308px;
        height: 52px;
        background: #e0e0e0;
        font-weight: bold;
        font-size: 18px;
        line-height: 52px;
        text-align: center;
        margin-bottom: 5px;
    }

    .date {
        position: relative;
        width: 341px;
        height: 24px;
        float: right;
        font-size: 14px;
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }

        .date input[type="date"] {
            margin-left: 8px;
            flex: 1;
            padding: 4px 6px;
            font-size: 14px;
        }

    .department {
        position: relative;
        width: 219px;
        height: 29px;
        float: left;
        font-size: 14px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
    }

        .department input[type="text"] {
            margin-left: 8px;
            flex: 1;
            padding: 4px 6px;
            font-size: 14px;
        }

    .nurse {
        position: relative;
        width: 338px;
        height: 29px;
        float: right;
        font-size: 14px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
    }

        .nurse input[type="text"] {
            margin-left: 8px;
            flex: 1;
            padding: 4px 6px;
            font-size: 14px;
        }

    .clear-fix {
        clear: both;
    }

    .title {
        text-align: center;
        font-weight: bold;
        font-size: 18px;
        margin-bottom: 20px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
        table-layout: fixed;
        word-wrap: break-word;
    }

    th, td {
        border: 1px solid #000;
        padding: 6px 8px;
        text-align: center;
        vertical-align: middle;
    }

    th {
        background: #eee;
    }

    tbody tr:nth-child(even) {
        background: #f9f9f9;
    }

    tbody td:nth-child(2) {
        text-align: left;
        padding-left: 10px;
    }

    input[type="radio"] {
        width: 100%;
        height: 100%;
        margin: 0;
        display: block;
        cursor: pointer;
    }

    .ddtk-label {
        margin-top: 30px;
        text-align: right;
        font-weight: bold;
        font-size: 14px;
    }

    table, tr, td, th {
        page-break-inside: avoid !important;
    }

    thead {
        display: table-header-group;
    }

    tfoot {
        display: table-footer-group;
    }
</style>
<form asp-action="@(isReuse ? "Create" : "Edit")" method="post">
    <input type="hidden" name="Id" value="@(isReuse ? 0 : Model.Id)" />
    <input type="hidden" name="TenForm" value="@Model.TenForm" />
    <div class="a4-container">
        <div class="logo" style="margin-bottom: 10px;">
            <a href="https://benhvienungbuou.vn/" target="_blank">
                <img src="https://benhvienungbuou.vn/wp-content/uploads/2022/12/Mask-group-2022-12-27T141100.572.png" alt="Logo" style="height: 52px; width: auto;">
            </a>
        </div>
        <div class="date">
            Ngày giám sát:
            <input type="date" name="NgayGiamSat" value="@Model.NgayGiamSat.ToString("yyyy-MM-dd")" />
        </div>
        <div class="clear-fix"></div>

        <div class="department">
    Khoa:
    <select name="Khoa" id="selectKhoa">
        <option value="">-- Chọn khoa --</option>
        @if (khoaList != null)
        {
            @foreach (var k in khoaList)
{
    var isSelected = Model.Khoa == k.TenKhoa ? "selected" : "";
    @:<option value="@k.TenKhoa" @isSelected>@k.TenKhoa</option>
}

        }
    </select>
</div>


        <div class="nurse">
            Điều dưỡng thực hiện: <input name="DieuDuongThucHien" type="text" value="@Model.DieuDuongThucHien" />
        </div>
        <div class="clear-fix"></div>

        <div class="title" style="text-align:center;">
            <input name="Title" value="@Model.Title"
                   style="width:100%;font-size:22px;font-weight:bold;text-align:center;border:none;outline:none;background:transparent;" />
        </div>
        <div class="time-note">Thời điểm đánh giá:</div>
        <!-- Nhóm checkbox tiêu chí -->
        <div>
            @{
                for (int i = 0; i < tatCaTieuChi.Count; i += 2)
                {
                    <div class="group-row">
                        <label class="checkbox-label">
                            <input type="checkbox" name="ThoiDiemDanhGia" value="@tatCaTieuChi[i]" @(thaoTacList.Contains(tatCaTieuChi[i]) ? "checked" : "") />
                            @tatCaTieuChi[i]
                        </label>
                        @if (i+1 < tatCaTieuChi.Count)
                        {
                            <label class="checkbox-label">
                                <input type="checkbox" name="ThoiDiemDanhGia" value="@tatCaTieuChi[i+1]" @(thaoTacList.Contains(tatCaTieuChi[i+1]) ? "checked" : "") />
                                @tatCaTieuChi[i+1]
                            </label>
                        }
                    </div>
                }
            }
        </div>
        <!-- Nếu lưu lại danh sách checkbox, JS sẽ serialize lại thành JSON cho NhomThaoTacJson -->
        <input type="hidden" name="NhomThaoTacJson" id="NhomThaoTacJson" value="@Model.NhomThaoTacJson" />

        <table border="1" cellspacing="0" cellpadding="5" style="width:100%; border-collapse: collapse;">
            <thead>
                <tr>
                <th rowspan="2" style="width:6%;">STT</th>
                <th rowspan="2" style="width:35%;">Các bước tiến hành</th>
                <th colspan="3" style="width:29%; text-align:center;">
                    NVYT Thực hiện
                    <br>
                    <input type="text" id="note-nvyt1" placeholder="Nhập ghi chú..." style="width:90%; margin-top:4px;">
                </th>
                <th colspan="3" style="width:29%; text-align:center;">
                    NVYT Thực hiện
                    <br>
                    <input type="text" id="note-nvyt2" placeholder="Nhập ghi chú..." style="width:90%; margin-top:4px;">
                </th>
            </tr>
                <tr>
                    <th>Thực hiện đầy đủ (1đ)</th>
                    <th>Thực hiện chưa đạt (0.5đ)</th>
                    <th>Không thực hiện (0đ)</th>
                    <th>Thực hiện đầy đủ (1đ)</th>
                    <th>Thực hiện chưa đạt (0.5đ)</th>
                    <th>Không thực hiện (0đ)</th>
                </tr>
            </thead>
            <tbody>
            @for (int i = 0; i < steps.Count; i++)
            {
                var step = steps[i];
                <tr>
                    <td>@(i + 1)</td>
                    <td>
                        @Html.Hidden($"KetQua[{i}].StepName", step.StepName)
                        @step.StepName
                    </td>
                    <!-- NVYT 1 -->
                    <td>
                        <input type="radio" name="KetQua[@i].KetQuaNhom1" value="1" @(step.KetQuaNhom1 == 1 ? "checked" : "") />
                    </td>
                    <td>
                        <input type="radio" name="KetQua[@i].KetQuaNhom1" value="0.5" @(step.KetQuaNhom1 == 0.5 ? "checked" : "") />
                    </td>
                    <td>
                        <input type="radio" name="KetQua[@i].KetQuaNhom1" value="0" @(step.KetQuaNhom1 == 0 ? "checked" : "") />
                    </td>
                    <!-- NVYT 2 -->
                    <td>
                        <input type="radio" name="KetQua[@i].KetQuaNhom2" value="1" @(step.KetQuaNhom2 == 1 ? "checked" : "") />
                    </td>
                    <td>
                        <input type="radio" name="KetQua[@i].KetQuaNhom2" value="0.5" @(step.KetQuaNhom2 == 0.5 ? "checked" : "") />
                    </td>
                    <td>
                        <input type="radio" name="KetQua[@i].KetQuaNhom2" value="0" @(step.KetQuaNhom2 == 0 ? "checked" : "") />
                    </td>
                </tr>
            }
            </tbody>
        </table>
        <div class="ddtk-label" style="margin-top:30px;">Giám sát viên: <input type="text" name="NguoiGiamSat" value="@Model.NguoiGiamSat" style="border:none;outline:none;font-weight:bold;" /></div>
        <div style="margin-top: 80px; font-size: 13px; line-height: 1.5;">
        <strong>Lưu ý:</strong><br>
        Một số ghi chú:<br>
        + NVYT sử dụng câu hỏi mở (với thông tin: họ tên, năm sinh/ tuổi, địa chỉ) và kiểm tra lại sau khi NB/ thân nhân trả lời;<br>
        + Yếu tố giới tính không áp dụng tại: Phòng khám tuyến vú, phụ khoa;<br>
        &nbsp;&nbsp;&nbsp;&nbsp;Khoa Ngoại tuyến vú, Ngoại phụ khoa, Xạ trị phụ khoa;<br>
        + Yếu tố địa chỉ: Phải đầy đủ 3 cấp thông tin cư trú (xã/phường/thị trấn, quận/huyện/thành phố/tỉnh);<br>
        Sau khi đánh giá chi tiết từng yếu tố đính kèm của mục 1 (đúng người bệnh) → tiến hành kết luận nội dung “đúng người bệnh” như sau:<br>
        “Đạt”: khi ít nhất 3 yếu tố được đánh giá ở cột “thực hiện đầy đủ - 1đ”;<br>
        “Chưa đạt”: khi đánh giá ít hơn 3 yếu tố; hoặc khi đánh giá từ 3 yếu tố trở lên nhưng chỉ có 2 yếu tố ở cột “thực hiện đầy đủ - 1đ”;<br>
        “Không đạt”: khi tiếp xúc người bệnh mà không xác nhận lại thông tin của người bệnh;<br>
        Các nội dung còn lại đánh giá theo thang điểm có sẵn.
    </div>
    </div>
    <div style="text-align:center; margin-top: 20px;">
        <button type="submit" class="btn btn-primary" style="padding: 10px 20px; font-size: 16px;">
            Lưu thay đổi
        </button>
        <a href="@Url.Action("Details", "BangKiem", new { id = Model.Id })" class="btn btn-secondary">Quay lại</a>
    </div>
</form>
<script>
    // Serialize lại danh sách các checkbox đã chọn (Thời điểm đánh giá) thành JSON khi submit
    document.querySelector("form").addEventListener("submit", function (e) {
        var checked = [];
        document.querySelectorAll('input[type="checkbox"][name="ThoiDiemDanhGia"]:checked').forEach(cb => checked.push(cb.value));
        document.getElementById('NhomThaoTacJson').value = JSON.stringify(checked);
    });
</script>
