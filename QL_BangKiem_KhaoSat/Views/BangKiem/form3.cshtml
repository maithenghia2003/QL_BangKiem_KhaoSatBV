@{
    ViewData["Title"] = "Form 3 - Bảng Kiểm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .a4-container {
        background: white;
        width: 794px;
        min-height: 1123px;
        margin: 0 auto;
        margin-top: 20px;
        padding: 20px 15px;
        box-sizing: border-box;
        box-shadow: 0 0 10px rgba(0,0,0,0.2);
        position: relative;
    }

    .logo {
        width: 308px;
        height: 52px;
        background: #e0e0e0;
        font-weight: bold;
        font-size: 18px;
        line-height: 52px;
        text-align: center;
        margin-bottom: 5px;
    }

    .date {
        position: relative;
        width: 341px;
        height: 24px;
        float: right;
        font-size: 14px;
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }

        .date input[type="date"] {
            margin-left: 8px;
            flex: 1;
            padding: 4px 6px;
            font-size: 14px;
        }

    .department {
        position: relative;
        width: 219px;
        height: 29px;
        float: left;
        font-size: 14px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
    }

        .department input[type="text"] {
            margin-left: 8px;
            flex: 1;
            padding: 4px 6px;
            font-size: 14px;
        }

    .nurse {
        position: relative;
        width: 338px;
        height: 29px;
        float: right;
        font-size: 14px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
    }

        .nurse input[type="text"] {
            margin-left: 8px;
            flex: 1;
            padding: 4px 6px;
            font-size: 14px;
        }

    .clear-fix {
        clear: both;
    }

    .title {
        text-align: center;
        font-weight: bold;
        font-size: 18px;
        margin-bottom: 20px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
        table-layout: fixed;
        word-wrap: break-word;
    }

    th, td {
        border: 1px solid #000;
        padding: 6px 8px;
        text-align: center;
        vertical-align: middle;
    }

    th {
        background: #eee;
    }

    tbody tr:nth-child(even) {
        background: #f9f9f9;
    }

    tbody td:nth-child(2) {
        text-align: left;
        padding-left: 10px;
    }

    input[type="radio"] {
        width: 100%;
        height: 100%;
        margin: 0;
        display: block;
        cursor: pointer;
    }

    .ddtk-label {
        margin-top: 30px;
        text-align: right;
        font-weight: bold;
        font-size: 14px;
    }

    table, tr, td, th {
        page-break-inside: avoid !important;
    }

    thead {
        display: table-header-group;
    }

    tfoot {
        display: table-footer-group;
    }

    .radio-column {
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: 14px;
        line-height: 1.4;
    }

        .radio-column label {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .radio-column input[type="radio"] {
            width: 16px;
            height: 16px;
            margin: 0;
        }
</style>

<div class="a4-container" id="capture">
    <!-- Logo -->
    <div class="logo">
        <a href="https://benhvienungbuou.vn/" target="_blank">
            <img src="https://benhvienungbuou.vn/wp-content/uploads/2022/12/Mask-group-2022-12-27T141100.572.png" alt="Logo" style="height: 52px; width: auto;">
        </a>
    </div>
    <!-- Khoa và ngày -->
    <div class="date">Ngày giám sát: <input type="date" /></div>
    <div class="clear-fix"></div>

    <div class="department">
        Khoa:
        <select id="selectKhoa">
            <option value="">-- Chọn khoa --</option>
        </select>
    </div>

    <div class="nurse">Điều dưỡng thực hiện: <input type="text" /></div>
    <div class="clear-fix"></div>

    <div class="title">
        <input id="inputTitle" type="text"
               placeholder="📋 Nhập tên bảng kiểm..."
               style="width:100%;font-size:24px;font-weight:bold;text-align:center;border:none;outline:none;background:transparent;color:#2c3e50;" />
    </div>
    <!-- Dòng thời điểm đánh giá -->
    <div class="time-note">
        Thời điểm đánh giá:
    </div>
    <!-- Nhóm checkbox -->
    <div class="group-row">
        <label class="checkbox-label">
            <input type="checkbox" name="group[]" value="1.1 Tiếp nhận NB đăng ký khám bệnh" /> 1.1 Tiếp nhận NB đăng ký khám bệnh
        </label>
        <label class="checkbox-label">
            <input type="checkbox" name="group[]" value="1.2 Tư vấn" /> 1.2 Tư vấn
        </label>
    </div>
    <div class="group-row">
        <label class="checkbox-label">
            <input type="checkbox" name="group[]" value="2.1 Thanh toán viện phí" /> 2.1 Thanh toán viện phí
        </label>
        <label class="checkbox-label">
            <input type="checkbox" name="group[]" value="2.2 Thu phí cận lâm sàng" /> 2.2 Thu phí cận lâm sàng
        </label>
    </div>
    <div class="group-row">
        <label class="checkbox-label">
            <input type="checkbox" name="group[]" value="3.1 Cấp phát thuốc" /> 3.1 Cấp phát thuốc
        </label>
        <label class="checkbox-label">
            <input type="checkbox" name="group[]" value="3.2 Cấp phát toa thuốc" /> 3.2 Cấp phát toa thuốc
        </label>
        <label class="checkbox-label">
            <input type="checkbox" name="group[]" value="3.3 Cấp phiếu hẹn" /> 3.3 Cấp phiếu hẹn
        </label>
    </div>
    <div class="group-row">
        <label class="checkbox-label">
            <input type="checkbox" name="group[]" value="4.1 Thực hiện cận lâm sàng" /> 4.1 Thực hiện cận lâm sàng
        </label>
        <label class="checkbox-label">
            <input type="checkbox" name="group[]" value="4.2 Cấp phát chỉ định cận lâm sàng" /> 4.2 Cấp phát chỉ định cận lâm sàng
        </label>
        <label class="checkbox-label">
            <input type="checkbox" name="group[]" value="4.3 Trả kết quả CLS" /> 4.3 Trả kết quả CLS
        </label>
    </div>
    <div class="group-row">
        <label class="checkbox-label">
            <input type="checkbox" name="group[]" value="5.1 Thực hiện kỹ thuật" /> 5.1 Thực hiện kỹ thuật
        </label>
        <label class="checkbox-label">
            <input type="checkbox" name="group[]" value="5.2 Thực hiện thủ thuật" /> 5.2 Thực hiện thủ thuật
        </label>
        <label class="checkbox-label">
            <input type="checkbox" name="group[]" value="5.3 Thực hiện phẫu thuật" /> 5.3 Thực hiện phẫu thuật
        </label>
        <label class="checkbox-label">
            <input type="checkbox" name="group[]" value="5.4 Thực hiện CLS" /> 5.4 Thực hiện CLS
        </label>
    </div>
    <div class="group-row">
        <label class="checkbox-label">
            <input type="checkbox" name="group[]" value="6.1 Nhập viện" /> 6.1 Nhập viện
        </label>
        <label class="checkbox-label">
            <input type="checkbox" name="group[]" value="6.2 Chuyển khoa" /> 6.2 Chuyển khoa
        </label>
        <label class="checkbox-label">
            <input type="checkbox" name="group[]" value="6.3 Chuyển viện" /> 6.3 Chuyển viện
        </label>
        <label class="checkbox-label">
            <input type="checkbox" name="group[]" value="6.4 Xuất viện" /> 6.4 Xuất viện
        </label>
    </div>
    <table border="1" cellspacing="0" cellpadding="5" style="width:100%; border-collapse: collapse;">
        <thead>
            <tr>
                <th rowspan="2" style="width:6%;">STT</th>
                <th rowspan="2" style="width:35%;">Các bước tiến hành</th>
                <th colspan="3" style="width:29%; text-align:center;">
                    NVYT Thực hiện
                    <br>
                    <input type="text" id="note-nvyt1" placeholder="Nhập ghi chú..." style="width:90%; margin-top:4px;">
                </th>
                <th colspan="3" style="width:29%; text-align:center;">
                    NVYT Thực hiện
                    <br>
                    <input type="text" id="note-nvyt2" placeholder="Nhập ghi chú..." style="width:90%; margin-top:4px;">
                </th>
            </tr>
            <tr style="text-align:center;">
                <th>Thực hiện đầy đủ (1đ)</th>
                <th>Thực hiện chưa đạt (0.5đ)</th>
                <th>Không thực hiện (0đ)</th>
                <th>Thực hiện đầy đủ (1đ)</th>
                <th>Thực hiện chưa đạt (0.5đ)</th>
                <th>Không thực hiện (0đ)</th>
            </tr>
        </thead>
        <tbody id="table-body"></tbody>
    </table>
    <div class="ddtk-label">Giám sát viên</div>
    <div style="margin-top: 80px; font-size: 13px; line-height: 1.5;">
        <!-- (Ghi chú/lưu ý giữ nguyên như bạn gửi) -->
        <strong>Lưu ý:</strong><br>
        Một số ghi chú:<br>
        + NVYT sử dụng câu hỏi mở (với thông tin: họ tên, năm sinh/ tuổi, địa chỉ) và kiểm tra lại sau khi NB/ thân nhân trả lời;<br>
        + Yếu tố giới tính không áp dụng tại: Phòng khám tuyến vú, phụ khoa;<br>
        &nbsp;&nbsp;&nbsp;&nbsp;Khoa Ngoại tuyến vú, Ngoại phụ khoa, Xạ trị phụ khoa;<br>
        + Yếu tố địa chỉ: Phải đầy đủ 3 cấp thông tin cư trú (xã/phường/thị trấn, quận/huyện/thành phố/tỉnh);<br>
        Sau khi đánh giá chi tiết từng yếu tố đính kèm của mục 1 (đúng người bệnh) → tiến hành kết luận nội dung “đúng người bệnh” như sau:<br>
        “Đạt”: khi ít nhất 3 yếu tố được đánh giá ở cột “thực hiện đầy đủ - 1đ”;<br>
        “Chưa đạt”: khi đánh giá ít hơn 3 yếu tố; hoặc khi đánh giá từ 3 yếu tố trở lên nhưng chỉ có 2 yếu tố ở cột “thực hiện đầy đủ - 1đ”;<br>
        “Không đạt”: khi tiếp xúc người bệnh mà không xác nhận lại thông tin của người bệnh;<br>
        Các nội dung còn lại đánh giá theo thang điểm có sẵn.
    </div>
</div>
<div style="display: flex; justify-content: center; gap: 15px; margin-top: 30px;">
    <button onclick="saveFormBangKiem()" class="btn btn-primary">
        <i class="fas fa-save"></i> Lưu phiếu kiểm
    </button>
    <button onclick="saveAsImage()" class="btn btn-success">
        <i class="fas fa-image"></i> Xuất ảnh
    </button>
    <a href="/Step/Index?formKey=Form3" class="btn btn-info">
        <i class="fas fa-plus"></i> Thêm bước
    </a>
</div>



<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script>
    // ----- DỮ LIỆU BƯỚC (có thể lấy từ ViewBag nếu muốn động) -----
    var steps = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Steps ?? new List<string>()));
    console.log("steps: ", steps);
    const tableBody = document.getElementById('table-body');
    tableBody.innerHTML = '';

    steps.forEach((step, index) => {
        const row = document.createElement('tr');
        if (index === steps.length - 1) { // Dòng cuối cùng "Kết luận bảng kiểm"
            row.innerHTML = `
                <td colspan="2" style="text-align:center;">${step}</td>
                <td colspan="3" style="padding-left: 10px; vertical-align: top;">
            <div class="radio-column">
                <label><input type="radio" name="step${index}-nvyt1" value="1"> Đạt</label>
                <label><input type="radio" name="step${index}-nvyt1" value="0"> Không đạt</label>
                <label><input type="radio" name="step${index}-nvyt1" value="0.5"> Chưa đạt</label>
            </div>
        </td>
        <td colspan="3" style="padding-left: 10px; vertical-align: top;">
            <div class="radio-column">
                <label><input type="radio" name="step${index}-nvyt2" value="1"> Đạt</label>
                <label><input type="radio" name="step${index}-nvyt2" value="0"> Không đạt</label>
                <label><input type="radio" name="step${index}-nvyt2" value="0.5"> Chưa đạt</label>
            </div>
        </td>
            `;
        } else {
            row.innerHTML = `
                <td style="text-align:center;">${index + 1}</td>
                <td>${step}</td>
                <td style="text-align:center;">
                    <input type="radio" name="step${index}-nvyt1" value="1">
                </td>
                <td style="text-align:center;">
                    <input type="radio" name="step${index}-nvyt1" value="0.5">
                </td>
                <td style="text-align:center;">
                    <input type="radio" name="step${index}-nvyt1" value="0">
                </td>
                <td style="text-align:center;">
                    <input type="radio" name="step${index}-nvyt2" value="1">
                </td>
                <td style="text-align:center;">
                    <input type="radio" name="step${index}-nvyt2" value="0.5">
                </td>
                <td style="text-align:center;">
                    <input type="radio" name="step${index}-nvyt2" value="0">
                </td>
            `;
        }
        tableBody.appendChild(row);
    });
    fetch('/Khoa/GetAll')
    .then(res => res.json())
    .then(data => {
        console.log(data);
        let html = '<option value="">-- Chọn khoa --</option>';
        data.forEach(khoa => {
            html += `<option value="${khoa.tenKhoa}">${khoa.tenKhoa}</option>`;
        });
        document.getElementById('selectKhoa').innerHTML = html;
    });

    // ---- HÀM LƯU ẢNH (giữ nguyên) ----
    function saveAsImage() {
        const element = document.getElementById("capture");
        html2canvas(element, {
            scale: 2,
            useCORS: true
        }).then(canvas => {
            const link = document.createElement("a");
            link.download = 'bang_kiem_xac_dinh_dich_vu.png';
            link.href = canvas.toDataURL('image/png');
            link.click();
        });
    }

    // ----- GATHER DỮ LIỆU LƯU PHIẾU -----
    function gatherFormBangKiemData() {
        // Lấy các checkbox nhóm thao tác (group-row)
        let groupChecks = [];
        document.querySelectorAll('.group-row input[type="checkbox"]:checked').forEach(c => groupChecks.push(c.value));

        var data = {
            Title: document.getElementById('inputTitle').value || "",
            TenForm: '@ViewData["Title"]',
            NgayGiamSat: document.querySelector('.date input')?.value || "",
            Khoa: document.getElementById('selectKhoa').value,
            DieuDuongThucHien: document.querySelector('.nurse input')?.value || "",
            NguoiGiamSat: document.querySelector('.ddtk-label')?.innerText || "",
            NhomThaoTacJson: JSON.stringify(groupChecks), // Lưu các nhóm thao tác
            KetQua: []
        };

        // Ghi chú NVYT
        let noteNvyt1 = document.getElementById('note-nvyt1')?.value || "";
        let noteNvyt2 = document.getElementById('note-nvyt2')?.value || "";

        // Lấy kết quả từng bước
        var rows = document.querySelectorAll("#table-body tr");
        for (var i = 0; i < rows.length; i++) {
            let stepName = steps[i] || ("Bước " + (i + 1));
            // Nếu là dòng cuối cùng (kết luận) --> lấy checkbox
            if (i === 6) {
                let values1 = [];
                let values2 = [];
                rows[i].querySelectorAll('input[name="step6-nvyt1"]:checked').forEach(x => values1.push(x.value));
                rows[i].querySelectorAll('input[name="step6-nvyt2"]:checked').forEach(x => values2.push(x.value));

                data.KetQua.push({
                    StepIndex: i + 1,
                    StepName: stepName,
                    KetQuaLoai: "Checkbox",
                    KetQuaNhom1: null,
                    KetQuaNhom2: null,
                    KetQuaNhom1List: values1,   // <== thêm dòng này
                    KetQuaNhom2List: values2,   // <== thêm dòng này
                    Diem: null,
                    LoaiKetQua: "",
                    SubSteps: [],
                    NoteNvyt1: noteNvyt1,
                    NoteNvyt2: noteNvyt2
            });
            } else {
                // Còn lại là radio
                let diem1 = null;
                let diem2 = null;
                let radios1 = rows[i].querySelectorAll('input[name="step' + i + '-nvyt1"]');
                let radios2 = rows[i].querySelectorAll('input[name="step' + i + '-nvyt2"]');
                radios1.forEach(r => { if (r.checked) diem1 = parseFloat(r.value); });
                radios2.forEach(r => { if (r.checked) diem2 = parseFloat(r.value); });
                data.KetQua.push({
                    StepIndex: i + 1,
                    StepName: stepName,
                    KetQuaLoai: "Radio",
                    KetQuaNhom1: diem1,
                    KetQuaNhom2: diem2,
                    Diem: null,
                    LoaiKetQua: "",
                    SubSteps: [],
                    NoteNvyt1: noteNvyt1,
                    NoteNvyt2: noteNvyt2
                });
            }
        }
        return data;
    }

    function saveFormBangKiem() {
        var data = gatherFormBangKiemData();
            fetch('/api/BangKiem/SaveBangKiem', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    })
    .then(response => {
        if (!response.ok) return response.text().then(text => { throw new Error(text); });
        return response.json();
    })
    .then(result => {
        if (result.success) {
            alert('Lưu phiếu kiểm thành công!');
        } else {
            alert('Có lỗi khi lưu phiếu kiểm!');
        }
    })
    .catch(err => {
        alert('Lỗi gửi dữ liệu: ' + err);
        console.error(err);
    });

    }
</script>


