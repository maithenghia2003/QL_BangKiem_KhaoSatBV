@model KhoaEntity
@{
    ViewData["Title"] = Model.Id == 0 ? "Thêm khoa" : "Sửa khoa";
}
<style>
    .a4-container {
        background: #fff;
        max-width: 500px;
        margin: 40px auto;
        border-radius: 12px;
        box-shadow: 0 0 14px 0 rgba(44,62,80,.09);
        padding: 32px 28px;
        font-size: 16px;
    }

        .a4-container h2 {
            font-size: 22px;
            text-align: center;
            margin-bottom: 22px;
            font-weight: 700;
        }

    .form-group {
        margin-bottom: 18px;
    }

    .form-label {
        font-weight: 600;
        margin-bottom: 4px;
        display: block;
    }

    .form-control {
        width: 100%;
        padding: 7px 12px;
        border-radius: 6px;
        border: 1px solid #ddd;
        font-size: 16px;
    }

    .form-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 20px;
    }

    .btn-primary {
        background: #228be6;
        color: #fff;
        border: none;
        padding: 8px 20px;
        border-radius: 7px;
        font-weight: 600;
    }

    .btn-secondary {
        background: #adb5bd;
        color: #fff;
        border: none;
        padding: 8px 20px;
        border-radius: 7px;
        font-weight: 600;
    }
</style>
<div class="a4-container">
    <h2>@ViewData["Title"]</h2>
    <form method="post">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label class="form-label" asp-for="TenKhoa"></label>
            <input asp-for="TenKhoa" class="form-control" required />
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Lưu</button>
            <a href="/Khoa" class="btn btn-secondary">Quay lại</a>
        </div>
    </form>
</div>
