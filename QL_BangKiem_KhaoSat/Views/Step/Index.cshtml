@model List<QL_BangKiem_KhaoSat.Models.StepEntity>
@{
    ViewData["Title"] = "Quản lý Bước kiểm";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var formKey = ViewBag.FormKey as string ?? "Form1";
}

<!-- Giao diện đồng bộ với layout -->
<div class="ds-container">
    <div class="ds-title">Danh sách Bước - @formKey</div>

    <div class="mb-3">
        <a href="@Url.Action("Create", new { formKey = formKey })" class="btn btn-success">
            <i class="fas fa-plus"></i> Thêm bước mới
        </a>
    </div>
    <form asp-action="BulkUpdateStatus" method="post">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th><input type="checkbox" id="selectAll" /></th>
                    <th>Thứ tự</th>
                    <th>Nội dung bước</th>
                    <th>Trạng thái</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var step in Model)
                {
                    <tr>
                        <td><input type="checkbox" name="SelectedIds" value="@step.Id" /></td>
                        <td>@step.StepIndex</td>
                        <td>@step.StepName</td>
                        <td>@(step.IsActive ? "Đang dùng" : "Ẩn")</td>
                        <td>
                            <a href="@Url.Action("Edit", new { id = step.Id })" class="btn btn-sm btn-warning" title="Sửa">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a href="@Url.Action("Delete", new { id = step.Id })" class="btn btn-sm btn-danger" title="Xóa" onclick="return confirm('Xác nhận xoá bước này?');">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex gap-2">
            <button type="submit" name="actionType" value="activate" class="btn btn-success">
                <i class="fas fa-eye"></i> Hiển thị các bước đã chọn
            </button>
            <button type="submit" name="actionType" value="deactivate" class="btn btn-secondary">
                <i class="fas fa-eye-slash"></i> Ẩn các bước đã chọn
            </button>
        </div>
    </form>

    <script>
        document.getElementById('selectAll').addEventListener('change', function () {
            const checkboxes = document.querySelectorAll('input[name="SelectedIds"]');
            checkboxes.forEach(cb => cb.checked = this.checked);
        });
    </script>

    

    <!-- Chuyển form khác (ví dụ: Form2, Form3...) -->
    <form method="get" asp-action="Index" class="mt-4">
        <label class="form-label">Chọn bảng kiểm:</label>
        <select name="formKey" onchange="this.form.submit()" class="form-select w-auto d-inline-block">
            <option value="Form1" selected="@((formKey == "Form1") ? "selected" : null)">Form1</option>
            <option value="Form2" selected="@((formKey == "Form2") ? "selected" : null)">Form2</option>
            <option value="Form3" selected="@((formKey == "Form3") ? "selected" : null)">Form3</option>
            <option value="Form4" selected="@((formKey == "Form4") ? "selected" : null)">Form4</option>
        </select>
    </form>
</div>

<!-- FontAwesome icon -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    .ds-container {
        width: 65vw;
        max-width: 65vw;
        margin: 36px auto;
        padding: 30px 40px;
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 2px 20px rgba(80,120,180,.11);
    }

    .ds-title {
        font-size: 24px;
        font-weight: 600;
        margin-bottom: 20px;
        text-align: center;
        color: #2652aa;
    }
</style>
