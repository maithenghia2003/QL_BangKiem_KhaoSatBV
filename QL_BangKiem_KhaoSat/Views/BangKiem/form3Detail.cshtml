@model QL_BangKiem_KhaoSat.Models.BangKiemEntity
@{
    ViewData["Title"] = "Chi tiết Form 3 - Bảng Kiểm";
    var steps = Model.KetQua?.ToList() ?? new List<QL_BangKiem_KhaoSat.Models.BangKiemStepResult>();
    var ghiChu = Model.Note ?? Model.GhiChu ?? "";
    List<string> thaoTacList = new List<string>();
    if (!string.IsNullOrEmpty(Model.NhomThaoTacJson))
    {
        thaoTacList = System.Text.Json.JsonSerializer.Deserialize<List<string>>(Model.NhomThaoTacJson);
    }
    var currentUserName = User.Identity?.Name;
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    bool coQuyenSua = userRole == "Admin" || userRole == "Giám sát viên" ||
                      (userRole == "Điều dưỡng" && Model.NguoiTao == currentUserName);
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<style>
    .a4-container {
        background: white;
        width: 794px;
        min-height: 1123px;
        margin: 0 auto;
        margin-top: 20px;
        padding: 20px 15px;
        box-sizing: border-box;
        box-shadow: 0 0 10px rgba(0,0,0,0.2);
        position: relative;
    }

    .logo {
        width: 308px;
        height: 52px;
        background: #e0e0e0;
        font-weight: bold;
        font-size: 18px;
        line-height: 52px;
        text-align: center;
        margin-bottom: 5px;
    }

    .date {
        position: relative;
        width: 341px;
        height: 24px;
        float: right;
        font-size: 14px;
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }

        .date input[type="date"] {
            margin-left: 8px;
            flex: 1;
            padding: 4px 6px;
            font-size: 14px;
        }

    .department {
        position: relative;
        width: 219px;
        height: 29px;
        float: left;
        font-size: 14px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
    }

        .department input[type="text"] {
            margin-left: 8px;
            flex: 1;
            padding: 4px 6px;
            font-size: 14px;
        }

    .nurse {
        position: relative;
        width: 338px;
        height: 29px;
        float: right;
        font-size: 14px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
    }

        .nurse input[type="text"] {
            margin-left: 8px;
            flex: 1;
            padding: 4px 6px;
            font-size: 14px;
        }

    .clear-fix {
        clear: both;
    }

    .title {
        text-align: center;
        font-weight: bold;
        font-size: 18px;
        margin-bottom: 20px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
        table-layout: fixed;
        word-wrap: break-word;
    }

    th, td {
        border: 1px solid #000;
        padding: 6px 8px;
        text-align: center;
        vertical-align: middle;
    }

    th {
        background: #eee;
    }

    tbody tr:nth-child(even) {
        background: #f9f9f9;
    }

    tbody td:nth-child(2) {
        text-align: left;
        padding-left: 10px;
    }

    input[type="radio"] {
        width: 100%;
        height: 100%;
        margin: 0;
        display: block;
        cursor: pointer;
    }

    .ddtk-label {
        margin-top: 30px;
        text-align: right;
        font-weight: bold;
        font-size: 14px;
    }

    table, tr, td, th {
        page-break-inside: avoid !important;
    }

    thead {
        display: table-header-group;
    }

    tfoot {
        display: table-footer-group;
    }

    media print {
        body

    {
        background: white !important;
        color: black !important;
    }

    .header, .footer, .navbar, .sidebar {
        display: none !important;
    }

    .a4-container {
        box-shadow: none !important;
        margin: 0 !important;
        width: 100% !important;
        min-height: initial !important;
        padding: 0 !important;
    }

    table, th, td {
        border: 1px solid #333 !important;
        color: #000 !important;
    }
    /* ... các style khác bạn muốn giữ lại hoặc thay đổi khi in ... */
    }
</style>
<div class="a4-container">
    <div class="logo" style="margin-bottom: 10px;">
        <a href="https://benhvienungbuou.vn/" target="_blank">
            <img src="https://benhvienungbuou.vn/wp-content/uploads/2022/12/Mask-group-2022-12-27T141100.572.png" alt="Logo" style="height: 52px; width: auto;">
        </a>
    </div>
    <div class="date">
        Ngày giám sát: <span>@Model.NgayGiamSat.ToString("yyyy-MM-dd")</span>
    </div>
    <div class="clear-fix"></div>

    <div class="department">
        Khoa: <span>@Model.Khoa</span>
    </div>

    <div class="nurse">
        Điều dưỡng thực hiện: <span>@Model.DieuDuongThucHien</span>
    </div>
    <div class="clear-fix"></div>

    <div class="title" style="text-align:center;">
        <span style="font-size:22px;font-weight:bold;text-align:center;">
            @Model.Title
        </span>
    </div>
    <div>
        <b>Thời điểm đánh giá:</b>
        @if (thaoTacList.Any())
        {
            foreach (var item in thaoTacList)
            {
                <span style="margin-right:10px">@item</span>
            }
        }
    </div>
    
    <table border="1" cellspacing="0" cellpadding="5" style="width:100%; border-collapse: collapse;">
        <thead>
            <tr>
                <th rowspan="2" style="width:6%;">STT</th>
                <th rowspan="2" style="width:35%;">Các bước tiến hành</th>
                <th colspan="3" style="width:29%; text-align:center;">
                    NVYT Thực hiện
                    <br>
                    <input type="text" id="note-nvyt1" placeholder="Nhập ghi chú..." style="width:90%; margin-top:4px;">
                </th>
                <th colspan="3" style="width:29%; text-align:center;">
                    NVYT Thực hiện
                    <br>
                    <input type="text" id="note-nvyt2" placeholder="Nhập ghi chú..." style="width:90%; margin-top:4px;">
                </th>
            </tr>
            <tr>
                <th>Thực hiện đầy đủ (1đ)</th>
                <th>Thực hiện chưa đạt (0.5đ)</th>
                <th>Không thực hiện (0đ)</th>
                <th>Thực hiện đầy đủ (1đ)</th>
                <th>Thực hiện chưa đạt (0.5đ)</th>
                <th>Không thực hiện (0đ)</th>
            </tr>
        </thead>
        <tbody>
            @functions {
                // Render chấm tròn màu hoặc chấm tròn rỗng
                string RenderCircle(double? val, double match)
                {
                    // Nếu đúng giá trị, vẽ chấm to màu xanh/cam/đỏ
                    if (val == match)
                    {
                        var color = match == 1 ? "green" : (match == 0.5 ? "orange" : "red");
                        return $"<span style='font-size:18px;color:{color}'>&#9679;</span>"; // ●
                    }
                    // Nếu không đúng, vẽ chấm rỗng màu xám
                    return "<span style='font-size:18px;color:#bbb'>&#9675;</span>"; // ○
                }
            }
            @for (int i = 0; i < steps.Count; i++)
            {
                var step = steps[i];
                <tr>
                    <td>@(i + 1)</td>
                    <td>@step.StepName</td>
                    <!-- NVYT 1 -->
                    <td>@Html.Raw(RenderCircle(step.KetQuaNhom1, 1))</td>
                    <td>@Html.Raw(RenderCircle(step.KetQuaNhom1, 0.5))</td>
                    <td>@Html.Raw(RenderCircle(step.KetQuaNhom1, 0))</td>
                    <!-- NVYT 2 -->
                    <td>@Html.Raw(RenderCircle(step.KetQuaNhom2, 1))</td>
                    <td>@Html.Raw(RenderCircle(step.KetQuaNhom2, 0.5))</td>
                    <td>@Html.Raw(RenderCircle(step.KetQuaNhom2, 0))</td>
                </tr>
            }

        </tbody>
    </table>
    <div class="ddtk-label" style="margin-top:30px;">Giám sát viên: <b>@Model.NguoiGiamSat</b></div>
    <div style="margin-top: 80px; font-size: 13px; line-height: 1.5;">
        <strong>Lưu ý:</strong><br>
        Một số ghi chú:<br>
        + NVYT sử dụng câu hỏi mở (với thông tin: họ tên, năm sinh/ tuổi, địa chỉ) và kiểm tra lại sau khi NB/ thân nhân trả lời;<br>
        + Yếu tố giới tính không áp dụng tại: Phòng khám tuyến vú, phụ khoa;<br>
        &nbsp;&nbsp;&nbsp;&nbsp;Khoa Ngoại tuyến vú, Ngoại phụ khoa, Xạ trị phụ khoa;<br>
        + Yếu tố địa chỉ: Phải đầy đủ 3 cấp thông tin cư trú (xã/phường/thị trấn, quận/huyện/thành phố/tỉnh);<br>
        Sau khi đánh giá chi tiết từng yếu tố đính kèm của mục 1 (đúng người bệnh) → tiến hành kết luận nội dung “đúng người bệnh” như sau:<br>
        “Đạt”: khi ít nhất 3 yếu tố được đánh giá ở cột “thực hiện đầy đủ - 1đ”;<br>
        “Chưa đạt”: khi đánh giá ít hơn 3 yếu tố; hoặc khi đánh giá từ 3 yếu tố trở lên nhưng chỉ có 2 yếu tố ở cột “thực hiện đầy đủ - 1đ”;<br>
        “Không đạt”: khi tiếp xúc người bệnh mà không xác nhận lại thông tin của người bệnh;<br>
        Các nội dung còn lại đánh giá theo thang điểm có sẵn.
    </div>
</div>
<div style="text-align:center; margin-top: 20px;">
    <a href="@Url.Action("Index", "BangKiem")" class="btn btn-secondary">Quay lại danh sách</a>
    @if (coQuyenSua)
    {
        <a href="@Url.Action("Edit", "BangKiem", new { id = Model.Id })" class="btn btn-warning">Sửa bảng kiểm</a>
    }
    <a href="@Url.Action("ExportPdf", "BangKiem", new { id = Model.Id })" class="btn btn-danger" target="_blank">
        <i class="fa fa-file-pdf"></i> Xuất PDF
    </a>
    <button onclick="window.print()" class="btn btn-primary">
        <i class="fa fa-print"></i> In phiếu kiểm
    </button>
</div>
<hr style="margin: 32px 0 14px 0;">
<div class="card" style="box-shadow:0 1px 10px #e5e9f2;border-radius:16px;padding:20px 26px;margin-bottom:32px;max-width:700px;margin-left:auto;margin-right:auto;">
    <h4 style="font-weight:bold;margin-bottom:12px;color:#3973e0;">Đánh giá / Nhận xét trực tuyến</h4>
    <div id="danhGiaList">
        @await Html.PartialAsync("DanhGiaList", ViewBag.DanhGiaList as List<QL_BangKiem_KhaoSat.Models.BangKiemDanhGia>)
    </div>
    @if (!User.Identity.IsAuthenticated)
    {
        <div style="color: #ff3300; margin-top:8px">
            Bạn cần đăng nhập để gửi nhận xét.
        </div>
    }
    else
    {
        <input type="hidden" id="bangKiemId" value="@Model.Id" />

        <form method="post" id="formComment">
            <textarea id="noiDung" name="NoiDung" rows="3" required style="width:100%; border-radius:8px; padding:8px;" placeholder="Nhập nhận xét..."></textarea>
            <button type="submit" class="btn btn-primary" style="margin-top:8px;">Gửi nhận xét</button>
        </form>

    }
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        $('#formComment').submit(function (e) {
            e.preventDefault();
            addDanhGia();
        });
    });
    function addDanhGia() {
        var bangKiemId = $('#bangKiemId').val();
        var noiDung = $('#noiDung').val();
        if (!noiDung.trim() || noiDung.length < 3) {
            alert("Nội dung phải nhập tối thiểu 3 ký tự!");
            $('#noiDung').focus(); return false;
        }
        $.post('/BangKiem/AddDanhGia', { bangKiemId, noiDung }, function (html) {
            $('#danhGiaList').html(html);
            $('#noiDung').val('');
        }).fail(function (xhr) {
            alert(xhr.responseText);
        });
        return false;
    }
</script>
