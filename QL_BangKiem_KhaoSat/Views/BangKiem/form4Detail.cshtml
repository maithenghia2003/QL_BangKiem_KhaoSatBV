@model QL_BangKiem_KhaoSat.Models.BangKiemEntity
@{
    ViewData["Title"] = "Chi tiết Bảng Kiểm Form 4";
    var ketQuaList = Model.KetQua.ToList();
    var currentUserName = User.Identity?.Name;
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    bool coQuyenSua = userRole == "Admin" || userRole == "Giám sát viên" ||
                      (userRole == "Điều dưỡng" && Model.NguoiTao == currentUserName);
}
<style>
    .a4-container {
        background: white;
        width: 794px;
        min-height: 1123px;
        margin: 0 auto;
        margin-top: 20px;
        padding: 20px 15px;
        box-sizing: border-box;
        box-shadow: 0 0 10px rgba(0,0,0,0.2);
        position: relative;
    }

    .logo {
        width: 308px;
        height: 52px;
        background: #e0e0e0;
        font-weight: bold;
        font-size: 18px;
        line-height: 52px;
        text-align: center;
        margin-bottom: 5px;
    }

    .date {
        position: relative;
        width: 341px;
        height: 24px;
        float: right;
        font-size: 14px;
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }

        .date input[type="date"] {
            margin-left: 8px;
            flex: 1;
            padding: 4px 6px;
            font-size: 14px;
        }

    .department {
        position: relative;
        width: 219px;
        height: 29px;
        float: left;
        font-size: 14px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
    }

        .department input[type="text"] {
            margin-left: 8px;
            flex: 1;
            padding: 4px 6px;
            font-size: 14px;
        }

    .nurse {
        position: relative;
        width: 338px;
        height: 29px;
        float: right;
        font-size: 14px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
    }

        .nurse input[type="text"] {
            margin-left: 8px;
            flex: 1;
            padding: 4px 6px;
            font-size: 14px;
        }

    .clear-fix {
        clear: both;
    }

    .title {
        text-align: center;
        font-weight: bold;
        font-size: 18px;
        margin-bottom: 20px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
        table-layout: fixed;
        word-wrap: break-word;
    }

    th, td {
        border: 1px solid #000;
        padding: 6px 8px;
        text-align: center;
        vertical-align: middle;
    }

    th {
        background: #eee;
    }

    tbody tr:nth-child(even) {
        background: #f9f9f9;
    }

    tbody td:nth-child(2) {
        text-align: left;
        padding-left: 10px;
    }

    input[type="radio"] {
        width: 100%;
        height: 100%;
        margin: 0;
        display: block;
        cursor: pointer;
    }

    .ddtk-label {
        margin-top: 30px;
        text-align: right;
        font-weight: bold;
        font-size: 14px;
    }

    table, tr, td, th {
        page-break-inside: avoid !important;
    }

    thead {
        display: table-header-group;
    }

    tfoot {
        display: table-footer-group;
    }

    .radio-column {
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: 14px;
        line-height: 1.4;
    }

        .radio-column label {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .radio-column input[type="radio"] {
            width: 16px;
            height: 16px;
            margin: 0;
        }
    media print {
        body

    {
        background: white !important;
        color: black !important;
    }

    .header, .footer, .navbar, .sidebar {
        display: none !important;
    }

    .a4-container {
        box-shadow: none !important;
        margin: 0 !important;
        width: 100% !important;
        min-height: initial !important;
        padding: 0 !important;
    }

    table, th, td {
        border: 1px solid #333 !important;
        color: #000 !important;
    }
    /* ... các style khác bạn muốn giữ lại hoặc thay đổi khi in ... */
    }
</style>

<div class="a4-container" id="capture">
    <div class="logo">
        <a href="https://benhvienungbuou.vn/" target="_blank">
            <img src="https://benhvienungbuou.vn/wp-content/uploads/2022/12/Mask-group-2022-12-27T141100.572.png" alt="Logo" style="height: 52px; width: auto;">
        </a>
    </div>
    <div class="info-row">
        <div class="department">
            Khoa: <span>@Model.Khoa</span>
        </div>
        <div class="date">Ngày giám sát: <span>@(Model.NgayGiamSat.ToString("yyyy-MM-dd"))</span></div>
    </div>
    <div style="height: 40px;"></div>
    <div class="title">
        <span style="font-size:22px;font-weight:bold;">@Model.Title</span>
    </div>
    <table border="1" cellspacing="0" cellpadding="5">
        <thead>
            <tr>
                <th rowspan="2" style="width:6%;">STT</th>
                <th rowspan="2" style="width:35%;">Các bước tiến hành</th>
                <th colspan="3" style="width:29%; text-align:center;">NVYT Thực hiện<br /></th>
                <th colspan="3" style="width:29%; text-align:center;">NVYT Thực hiện<br /></th>
            </tr>
            <tr style="text-align:center;">
                <th>Đầy đủ (1đ)</th>
                <th>Chưa đạt (0.5đ)</th>
                <th>Không (0đ)</th>
                <th>Đầy đủ (1đ)</th>
                <th>Chưa đạt (0.5đ)</th>
                <th>Không (0đ)</th>
            </tr>
        </thead>
        <tbody>
            @{
                int stt = 1;
                Func<double?, double, string> renderCircle = (val, match) => val == match
                ? $"<span style='font-size:18px;color:{(match == 1 ? "green" : match == 0.5 ? "orange" : "red")};'>&#9679;</span>" // ●
                : $"<span style='font-size:18px;color:#ccc;'>&#9675;</span>"; // ○

                foreach (var step in Model.KetQua.OrderBy(x => x.StepIndex))
                {
                    <tr>
                        <td>@stt</td>
                        <td>@step.StepName</td>
                        <td>@Html.Raw(renderCircle(step.KetQuaNhom1, 1))</td>
                        <td>@Html.Raw(renderCircle(step.KetQuaNhom1, 0.5))</td>
                        <td>@Html.Raw(renderCircle(step.KetQuaNhom1, 0))</td>
                        <td>@Html.Raw(renderCircle(step.KetQuaNhom2, 1))</td>
                        <td>@Html.Raw(renderCircle(step.KetQuaNhom2, 0.5))</td>
                        <td>@Html.Raw(renderCircle(step.KetQuaNhom2, 0))</td>
                    </tr>
                    if (step.SubSteps != null && step.SubSteps.Count > 0)
                    {
                        foreach (var sub in step.SubSteps)
                        {
                            <tr>
                                <td></td>
                                <td>@sub.SubStepName</td>
                                <td>@Html.Raw(renderCircle(sub.KetQuaNhom1, 1))</td>
                                <td>@Html.Raw(renderCircle(sub.KetQuaNhom1, 0.5))</td>
                                <td>@Html.Raw(renderCircle(sub.KetQuaNhom1, 0))</td>
                                <td>@Html.Raw(renderCircle(sub.KetQuaNhom2, 1))</td>
                                <td>@Html.Raw(renderCircle(sub.KetQuaNhom2, 0.5))</td>
                                <td>@Html.Raw(renderCircle(sub.KetQuaNhom2, 0))</td>
                            </tr>
                        }
                    }
                    stt++;
                }
            }

        </tbody>
    </table>
    <div class="ddtk-label">Giám sát viên: <span>@Model.NguoiGiamSat</span></div>
    <div style="margin-top: 80px; font-size: 13px; line-height: 1.5;">
        <strong>Lưu ý:</strong><br>
        <!-- ... giữ nguyên phần ghi chú như của bạn ... -->
    </div>
</div>
<div style="text-align:center; margin-top: 20px;">
    <a href="@Url.Action("Index", "BangKiem")" class="btn btn-secondary">Quay lại danh sách</a>
    @if (coQuyenSua)
    {
        <a href="@Url.Action("Edit", "BangKiem", new { id = Model.Id })" class="btn btn-warning">Sửa bảng kiểm</a>
    }
    <a href="@Url.Action("ExportPdf", "BangKiem", new { id = Model.Id })" class="btn btn-danger" target="_blank">
        <i class="fa fa-file-pdf"></i> Xuất PDF
    </a>
    <button onclick="window.print()" class="btn btn-primary">
        <i class="fa fa-print"></i> In phiếu kiểm
    </button>
</div>
<hr style="margin: 32px 0 14px 0;">
<div class="card" style="box-shadow:0 1px 10px #e5e9f2;border-radius:16px;padding:20px 26px;margin-bottom:32px;max-width:700px;margin-left:auto;margin-right:auto;">
    <h4 style="font-weight:bold;margin-bottom:12px;color:#3973e0;">Đánh giá / Nhận xét trực tuyến</h4>
    <div id="danhGiaList">
        @await Html.PartialAsync("DanhGiaList", ViewBag.DanhGiaList as List<QL_BangKiem_KhaoSat.Models.BangKiemDanhGia>)
    </div>
    @if (!User.Identity.IsAuthenticated)
    {
        <div style="color: #ff3300; margin-top:8px">
            Bạn cần đăng nhập để gửi nhận xét.
        </div>
    }
    else
    {
        <input type="hidden" id="bangKiemId" value="@Model.Id" />

        <form method="post" id="formComment">
            <textarea id="noiDung" name="NoiDung" rows="3" required style="width:100%; border-radius:8px; padding:8px;" placeholder="Nhập nhận xét..."></textarea>
            <button type="submit" class="btn btn-primary" style="margin-top:8px;">Gửi nhận xét</button>
        </form>

    }
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        $('#formComment').submit(function (e) {
            e.preventDefault();
            addDanhGia();
        });
    });
    function addDanhGia() {
        var bangKiemId = $('#bangKiemId').val();
        var noiDung = $('#noiDung').val();
        if (!noiDung.trim() || noiDung.length < 3) {
            alert("Nội dung phải nhập tối thiểu 3 ký tự!");
            $('#noiDung').focus(); return false;
        }
        $.post('/BangKiem/AddDanhGia', { bangKiemId, noiDung }, function (html) {
            $('#danhGiaList').html(html);
            $('#noiDung').val('');
        }).fail(function (xhr) {
            alert(xhr.responseText);
        });
        return false;
    }
</script>
