@model QL_BangKiem_KhaoSat.Models.StepEntity
@{
    ViewData["Title"] = "Xóa Bước";
}

<h2>Xóa bước này?</h2>
<div>
    <strong>Thứ tự:</strong> @Model.StepIndex<br />
    <strong>Nội dung:</strong> @Model.StepName
</div>
<form asp-action="Delete" method="post">
    <input type="hidden" name="Id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger mt-2">Xác nhận xóa (ẩn)</button>
    <a href="@Url.Action("Index", new { formKey = Model.FormKey })" class="btn btn-secondary mt-2">Hủy</a>
</form>
