@model List<UserEntity>
@{
    ViewData["Title"] = "Tài khoản chờ duyệt / từ chối";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<h2>Tài khoản chờ duyệt</h2>
<table class="table">
    <thead>
        <tr><th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Duyệt</th></tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.HoTen</td>
                <td>@u.Email</td>
                <td>@u.VaiTroId</td>
                <td>
                    <form asp-action="Duyet" method="post">
                        <input type="hidden" name="id" value="@u.Id" />
                        <button type="submit" class="btn btn-success btn-sm">Duyệt</button>
                    </form>

                    <form asp-action="TuChoi" method="post" style="margin-top: 5px;"
                          onsubmit="return confirm('Bạn có chắc chắn muốn từ chối và xóa tài khoản này?');">
                        <input type="hidden" name="id" value="@u.Id" />
                        <button type="submit" class="btn btn-danger btn-sm">Từ chối</button>
                    </form>
                </td>


            </tr>
        }
    </tbody>
</table>

