@model QL_BangKiem_KhaoSat.Models.HienThiBangKiem
@{
    ViewData["Title"] = "Danh sách Bảng Kiểm"; // Cập nhật tiêu đề
}

<style>
    body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f4f4f4;
    }
    .header {
        background-color: #3f51b5; /* Màu xanh dương tương tự */
        color: white;
        padding: 10px 20px; /* Điều chỉnh padding */
        display: flex;
        align-items: center;
        justify-content: space-between; /* Đẩy logo và menu ra hai bên */
    }
    .logo img {
        height: 40px; /* Điều chỉnh kích thước logo */
        vertical-align: middle; /* Căn chỉnh logo với text */
    }
    .menu a {
        color: white;
        text-decoration: none;
        margin-left: 20px; /* Khoảng cách giữa các mục menu */
        font-weight: bold;
    }
    .main-content {
        padding: 20px;
        text-align: center;
    }
    .grid-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); /* 3 cột trên màn hình lớn, tự động xuống dòng */
        gap: 25px; /* Khoảng cách giữa các ô */
        max-width: 1200px; /* Giới hạn chiều rộng của lưới */
        margin: 20px auto; /* Căn giữa lưới */
    }
    .card {
        background-color: white;
        border: 1px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        text-align: center;
        transition: transform 0.2s ease-in-out;
        text-decoration: none; /* Bỏ gạch chân cho thẻ a */
        color: inherit; /* Kế thừa màu chữ */
        display: flex;
        flex-direction: column;
        justify-content: space-between; /* Đẩy tiêu đề và mô tả lên/xuống */
    }
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 6px 12px rgba(0,0,0,0.15);
    }
    .card-image {
        width: 100%;
        height: 180px; /* Chiều cao cố định cho ảnh */
        object-fit: cover; /* Đảm bảo ảnh vừa vặn mà không bị méo */
        background-color: #e0e0e0; /* Màu nền placeholder */
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        color: #666;
        font-weight: bold;
    }
    .card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .card-content {
        padding: 15px;
        flex-grow: 1; /* Cho phép nội dung co giãn */
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .card-title {
        font-weight: bold;
        font-size: 1.1em;
        margin-bottom: 5px;
        color: #333;
    }
    .card-description {
        font-size: 0.9em;
        color: #666;
    }
</style>

<body>

    <div class="main-content">
        <h1>Danh sách Bảng Kiểm</h1>

        <div class="grid-container">
            @foreach (var item in Model.DSBangKiem)
            {
                <a href="@item.Url" class="card">
                    <div class="card-image">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.TenBangKiem" />
                        }
                        else
                        {
                            <span>Hình ảnh</span> 
                        }
                    </div>
                    <div class="card-content">
                        <div class="card-title">@item.TenBangKiem</div>
                        <div class="card-description">@item.MoTaNgan</div>
                    </div>
                </a>
            }
        </div>
    </div>
</body>
</html>