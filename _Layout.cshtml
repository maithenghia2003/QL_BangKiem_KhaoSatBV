    @using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var userName = HttpContextAccessor.HttpContext?.Session.GetString("UserName");
    var vaiTro = Context.Session.GetString("VaiTro");
       
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QL_BangKiem_KhaoSat</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QL_BangKiem_KhaoSat.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="topbar bg-primary text-white py-2">
            <div class="container d-flex justify-content-between align-items-center flex-wrap">
                <div class="d-flex align-items-center">
                    <img src="https://benhvienungbuou.vn/wp-content/uploads/2022/12/Mask-group-2022-12-27T141100.572.png" alt="Logo BVUB" style="height: 50px;" />
                </div>
                <div class="d-flex align-items-center flex-wrap gap-4 text-white">
                    <div class="d-flex align-items-center">
                        <img src="https://benhvienungbuou.vn/wp-content/uploads/2022/12/phone.png" alt="" style="height: 24px;" class="me-2" />
                        <div>
                            <strong>Hotline BV</strong><br />
                            (028) 3841 2637
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <img src="https://benhvienungbuou.vn/wp-content/uploads/2022/12/calendar.png" alt="" style="height: 24px;" class="me-2" />
                        <div>
                            <strong>Đặt hẹn khám</strong><br />
                            1900 636 223
                        </div>
                    </div>
                    <div>
                        <a class="btn btn-success rounded-pill px-3 py-1 text-white" href="/BangKiem">Tạo bảng kiểm</a>
                    </div>
                    <div>
                        <a class="btn btn-primary rounded-pill px-3 py-1 text-white" href="/BangKiem/List">Danh sách bảng kiểm đã tạo</a>
                    </div>
                    <div>
                        <a class="btn btn-warning rounded-pill px-3 py-1 text-white" href="/Admin/Admin">Adminpage</a>
                    </div>
                </div>
            </div>
        </div>
        <nav class="navbar navbar-light bg-light">
            <div class="container-fluid justify-content-end">
                <ul class="navbar-nav d-flex flex-row align-items-center gap-3">
                    @if (!string.IsNullOrEmpty(userName))
                    {
                        <li class="nav-item">
                            <span class="navbar-text">Chào, @userName!</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Account/DangXuat">Đăng xuất</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Account/DangNhap">Đăng nhập</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Account/DangKy">Đăng ký</a>
                        </li>
                    }
                </ul>
            </div>
        </nav>


    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted"></footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
