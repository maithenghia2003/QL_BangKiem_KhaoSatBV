@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var httpContext = HttpContextAccessor.HttpContext;
    var userName = httpContext?.Session.GetString("UserName");
    var vaiTro = httpContext?.Session.GetString("VaiTro");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
        body {
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .sidebar {
            width: 250px;
            background-color: #343a40;
            color: #fff;
            flex-shrink: 0;
        }

            .sidebar a {
                color: #ddd;
                text-decoration: none;
                display: block;
                padding: 12px 20px;
            }

                .sidebar a:hover, .sidebar a.active {
                    background-color: #495057;
                    color: #fff;
                }

        .main-content {
            flex-grow: 1;
            background-color: #f8f9fa;
            padding: 20px;
        }

        .topbar {
            background-color: #ffffff;
            border-bottom: 1px solid #dee2e6;
            padding: 10px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .topbar .user-info {
                font-weight: 500;
            }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="text-center border-bottom border-secondary">
            <a href="/Home/Index" class="d-block p-3 text-decoration-none">
                <img src="https://benhvienungbuou.vn/wp-content/uploads/2022/12/Mask-group-2022-12-27T141100.572.png" alt="Logo" class="img-fluid" style="max-height: 60px;" />
                <h5 class="mt-2 text-white">Admin Panel</h5>
            </a>
        </div>
        <nav class="mt-3">
            @if (!string.IsNullOrEmpty(vaiTro))
            {
                <a href="/BangKiem" class="@(Context.Request.Path.StartsWithSegments("/Home") ? "active" : "")">Home Page</a>

                @if (vaiTro == "Admin")
                {
                    <a href="/BangKiem/ThongKe">Thống kê</a>
                    <a href="/Khoa/Index">Quản lý khoa</a>
                    <a href="/Admin/ChoDuyet">Tài khoản chờ duyệt</a>
                    <a href="/Admin/LichSu">Lịch sử xử lý</a>
                }
            }
        </nav>
    </div>

    <!-- Main content -->
    <div class="main-content">
        <!-- Topbar -->
        <div class="topbar">
            <div><strong>Hệ thống khảo sát BV Ung Bướu</strong></div>
            <div class="user-info">
                @if (!string.IsNullOrEmpty(userName))
                {
                    <span>
                        Chào, <strong>@userName</strong> |
                        <a href="/Account/DangXuat" class="text-danger text-decoration-none">Đăng xuất</a>
                    </span>
                }
                else
                {
                    <span>
                        <a href="/Account/DangNhap" class="text-primary text-decoration-none">Đăng nhập</a> |
                        <a href="/Account/DangKy" class="text-primary text-decoration-none">Đăng ký</a>
                    </span>
                }
            </div>
        </div>

        <!-- Page Content -->
        <div class="mt-4">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
