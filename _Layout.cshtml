<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QL_BangKiem_KhaoSat</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QL_BangKiem_KhaoSat.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="topbar bg-primary text-white py-2">
            <div class="container d-flex justify-content-between align-items-center flex-wrap">
                <div class="d-flex align-items-center">
                    <a asp-controller="Home" asp-action="Index">
                        <img src="https://benhvienungbuou.vn/wp-content/uploads/2022/12/Mask-group-2022-12-27T141100.572.png" alt="Logo BVUB" style="height: 50px;" />
                    </a>
                </div>

                <div class="d-flex align-items-center flex-wrap gap-4 text-white">
                    <div class="d-flex align-items-center">
                        <img src="https://benhvienungbuou.vn/wp-content/uploads/2022/12/phone.png" alt="" style="height: 24px;" class="me-2" />
                        <div>
                            <strong>Hotline BV</strong><br />
                            (028) 3841 2637
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <img src="https://benhvienungbuou.vn/wp-content/uploads/2022/12/calendar.png" alt="" style="height: 24px;" class="me-2" />
                        <div>
                            <strong>Đặt hẹn khám</strong><br />
                            1900 636 223
                        </div>
                    </div>
                    <div>
                        <a class="btn btn-warning rounded-pill px-3 py-1 text-white" href="/Home/Index">
                            Danh sách tạo bảng kiểm
                        </a>
                    </div>
                    <div>
                        <a class="btn btn-success rounded-pill px-3 py-1 text-white" href="/FormBangKiem/ds">
                            Danh sách các bảng kiểm đã tạo
                        </a>
                    </div>
                    <!-- ✅ Nút ADMINPAGE thêm vào đây -->
                    <div>
                        <a class="btn btn-danger rounded-pill px-3 py-1 text-white" href="/Home/Admin">
                            ADMINPAGE
                        </a>
                    </div>
                </div>


        <!-- Đã loại bỏ phần navbar -->

    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
    