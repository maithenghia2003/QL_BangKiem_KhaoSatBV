@model List<QL_BangKiem_KhaoSat.Models.UserEntity>

<!-- Tài khoản đã duyệt -->
<div class="card-info">
    <div class="section-title">Tài khoản đã duyệt</div>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Họ tên</th>
                <th>Email</th>
                <th>Vai trò</th>
                <th>Trạng thái</th>
                <th>Ngày đăng ký</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Where(u => u.DaDuyet))
            {
                <tr>
                    <td>@user.HoTen</td>
                    <td>@user.Email</td>
                    <td>@user.VaiTro?.TenVaiTro</td>
                    <td class="text-success">✔️ Đã duyệt</td>
                    <td>@user.NgayDangKy.ToString("dd/MM/yyyy")</td>
                    <td class="d-flex gap-2">
                        <!-- Nút chuyển sang trang sửa -->
                        <a class="btn btn-sm btn-primary" href="/Admin/ChinhSuaTaiKhoan?id=@user.Id">Sửa</a>
                        <!-- Nút xóa -->
                        <form asp-action="TuChoiTaiKhoan" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài khoản này?')">
                            <input type="hidden" name="id" value="@user.Id" />
                            <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Tài khoản CHƯA duyệt -->
<div class="card-info mt-4">
    <div class="section-title">Tài khoản chờ duyệt</div>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Họ tên</th>
                <th>Email</th>
                <th>Vai trò</th>
                <th>Trạng thái</th>
                <th>Ngày đăng ký</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Where(u => !u.DaDuyet))
            {
                <tr>
                    <td>@user.HoTen</td>
                    <td>@user.Email</td>
                    <td>@user.VaiTro?.TenVaiTro</td>
                    <td class="text-danger">❌ Chờ duyệt</td>
                    <td>@user.NgayDangKy.ToString("dd/MM/yyyy")</td>
                    <td class="d-flex gap-2">
                        <form asp-action="DuyetTaiKhoan" method="post">
                            <input type="hidden" name="id" value="@user.Id" />
                            <button type="submit" class="btn btn-sm btn-success">Đồng ý</button>
                        </form>
                        <form asp-action="TuChoiTaiKhoan" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn từ chối tài khoản này?')">
                            <input type="hidden" name="id" value="@user.Id" />
                            <button type="submit" class="btn btn-sm btn-danger">Từ chối</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div id="form-sua-container"></div>

<script>
    function loadEditForm(userId) {
        fetch(`/Admin/LoadSuaTaiKhoan?id=${userId}`)
            .then(response => response.text())
            .then(html => {
                document.getElementById("form-sua-container").innerHTML = html;
            });
    }
</script>

