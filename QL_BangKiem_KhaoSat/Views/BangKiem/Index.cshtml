@{
    ViewData["Title"] = "Danh sách Bảng Kiểm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #f9fafc;
    }

    h1 {
        text-align: center;
        margin-top: 30px;
        margin-bottom: 25px;
        font-family: 'Segoe UI', sans-serif;
        font-weight: bold;
        color: #2c3e50;
    }

    .grid-container {
        display: grid;
        grid-template-columns: repeat(4, 1fr); /* Cố định 4 cột */
        gap: 30px; /* Giữ khoảng cách giữa các thẻ */
        max-width: 1200px; /* Đảm bảo đủ rộng cho 4 thẻ */
        margin: 0 auto 50px auto;
        padding: 0 15px;
    }

    .card {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 6px 15px rgba(0,0,0,0.1);
        cursor: pointer;
        overflow: hidden;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 20px;
        height: 400px; /* Đảm bảo chiều cao cố định */
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 18px rgba(0,0,0,0.15);
            background-color: #f2f7fc;
        }

        .card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 8px;
            margin-bottom: 15px;
        }

    .card-title {
        font-size: 20px;
        font-weight: bold;
        color: #333;
        font-family: 'Segoe UI', sans-serif;
        padding: 0 10px;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
    }
</style>

<h1>Danh sách Bảng Kiểm</h1>

<div class="grid-container" id="boardList">
    <!-- Các card bảng kiểm được tạo bằng JS -->
</div>

@section Scripts {
    <script>
        const boards = [
            {
                id: 1,
                title: "BẢNG KIỂM THỰC HIỆN KỸ THUẬT",
                url: "/BangKiem/Form1",
                image: "/img/card/image1.jpg"
            },
            {
                id: 2,
                title: "BẢNG KIỂM GIÁM SÁT NGƯỜI BỆNH ĐƯỢC THỰC HIỆN Y LỆNH THUỐC",
                url: "/BangKiem/Form2",
                image: "/img/card/image2.jpg"
            },
            {
                id: 3,
                title: "BẢNG KIỂM XÁC ĐỊNH ĐÚNG NGƯỜI BỆNH CUNG CẤP DỊCH VỤ",
                url: "/BangKiem/Form3",
                image: "/img/card/image3.jpg"
            },
            {
                id: 4,
                title: "BẢNG KIỂM ĐẢM BẢO AN TOÀN THỰC HIỆN",
                url: "/BangKiem/Form4",
                image: "/img/card/image4.jpg"
            }
        ];

        const boardListEl = document.getElementById('boardList');
        boards.forEach(board => {
            const card = document.createElement('div');
            card.className = 'card';
            card.innerHTML = `
                <img src="${board.image}" alt="${board.title}" onerror="this.src='https://via.placeholder.com/300x200?text=Image+Not+Found';">
                <div class="card-title">${board.title}</div>
            `;
            card.addEventListener('click', () => {
                location.href = board.url;
            });
            boardListEl.appendChild(card);
        });
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/js/all.min.js"
            integrity="sha512-a...tvo" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
}