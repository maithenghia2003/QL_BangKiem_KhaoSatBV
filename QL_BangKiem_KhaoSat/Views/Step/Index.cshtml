@model List<QL_BangKiem_KhaoSat.Models.StepEntity>
@{
    ViewData["Title"] = "Quản lý Bước kiểm";
    var formKey = ViewBag.FormKey as string ?? "Form1";
}

<h2>Danh sách Bước - @formKey</h2>
<a href="@Url.Action("Create", new { formKey = formKey })" class="btn btn-success">Thêm bước mới</a>

<table class="table table-bordered mt-3">
    <tr>
        <th>Thứ tự</th>
        <th>Nội dung bước</th>
        <th>Trạng thái</th>
        <th>Hành động</th>
    </tr>
    @foreach (var step in Model)
    {
        <tr>
            <td>@step.StepIndex</td>
            <td>@step.StepName</td> 
            <td>@(step.IsActive ? "Đang dùng" : "Ẩn")</td>
            <td>
                <a href="@Url.Action("Edit", new { id = step.Id })" class="btn btn-warning btn-sm">Sửa</a>
                <a href="@Url.Action("Delete", new { id = step.Id })" class="btn btn-danger btn-sm">Xóa</a>
            </td>
        </tr>
    }
</table>

<!-- Chuyển form khác (ví dụ: Form2, Form3...) -->
<form method="get" asp-action="Index" class="mt-3">
    <label>Chọn bảng kiểm:</label>
    <select name="formKey" onchange="this.form.submit()">
        <option value="Form1" selected="@((formKey == "Form1") ? "selected" : null)">Form1</option>
        <option value="Form2" selected="@((formKey == "Form2") ? "selected" : null)">Form2</option>
        <option value="Form3" selected="@((formKey == "Form3") ? "selected" : null)">Form3</option>
        <option value="Form4" selected="@((formKey == "Form4") ? "selected" : null)">Form4</option>
    </select>
</form>
