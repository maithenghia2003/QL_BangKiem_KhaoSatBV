@{
    ViewData["Title"] = "Admin Fullscreen";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Fullscreen</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <style>
        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background-color: #f1f4f9;
        }

        .admin-wrapper {
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        .sidebar {
            width: 300px;
            background-color: #343a40;
            color: white;
            display: flex;
            flex-direction: column;
            padding-top: 20px;
        }

            .sidebar a {
                padding: 12px 20px;
                color: #ced4da;
                text-decoration: none;
                display: block;
            }

                .sidebar a:hover, .sidebar a.active {
                    background-color: #495057;
                    color: white;
                }

        .main-content {
            flex: 1;
            padding: 30px;
            overflow-y: auto;
        }

        .card-info {
            border-left: 5px solid #007bff;
            background: white;
            padding: 20px;
            box-shadow: 0 0 8px rgba(0,0,0,0.05);
            margin-bottom: 20px;
        }

        .section-title {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 10px;
            color: #343a40;
        }

        .section-content {
            display: none;
        }

            .section-content.active {
                display: block;
            }
    </style>
</head>
<body>
    <div class="admin-wrapper">
        <!-- Sidebar -->
        <div class="sidebar">
            <a href="/Home/Index">
                <img src="https://benhvienungbuou.vn/wp-content/uploads/2022/12/Mask-group-2022-12-27T141100.572.png" alt="Logo" style="width: 90%; max-width: 200px; margin: 0 auto 20px;" />
            </a>
            <a href="#" class="menu-link active" data-section="user">User</a>
            <a href="#" class="menu-link" data-section="khoa">Khoa</a>
            <a href="#" class="menu-link" data-section="danhsach">Thống kê bảng kiểm</a>
        </div>

        <!-- Main content -->
        <div class="main-content">
            <!-- User -->
            <div id="section-user" class="section-content">
                <div class="text-muted">Đang tải danh sách user...</div>
            </div>


            <!-- Khoa -->
            <div id="section-khoa" class="section-content">
                <div id="khoa-container">
                    <div class="text-muted">Đang tải danh sách khoa...</div>
                </div>
            </div>

            <!-- Danh sách bảng kiểm -->
            <div id="section-danhsach" class="section-content">
                <div class="card-info">
                    <div class="section-title">Danh sách bảng kiểm</div>
                    <form method="get" class="row g-3 mb-3">
                        <div class="col-md-3"><input type="text" name="formKey" class="form-control form-control-sm" placeholder="Tên Form" /></div>
                        <div class="col-md-2"><input type="text" name="khoa" class="form-control form-control-sm" placeholder="Khoa" /></div>
                        <div class="col-md-2"><input type="date" name="tuNgay" class="form-control form-control-sm" /></div>
                        <div class="col-md-2"><input type="date" name="denNgay" class="form-control form-control-sm" /></div>
                        <div class="col-md-2"><button type="submit" class="btn btn-sm btn-primary">Lọc</button></div>
                    </form>
                    <table class="table table-bordered table-striped table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Form</th>
                                <th>Khoa</th>
                                <th>Số phiếu</th>
                                <th>Điểm TB</th>
                                <th>Số Đạt</th>
                                <th>Số chưa đạt</th>
                                <th>Tỉ lệ Đạt (%)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.TenForm</td>
                                        <td>@item.Khoa</td>
                                        <td>@item.SoLuongPhieu</td>
                                        <td>@item.DiemTrungBinh.ToString("0.##")</td>
                                        <td>@item.SoLuongDat</td>
                                        <td>@item.SoLuongChuaDat</td>
                                        <td>@item.TiLeDat %</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="7" class="text-center">Không có dữ liệu</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Chuyển section khi click menu
        document.querySelectorAll('.menu-link').forEach(link => {
            link.addEventListener('click', function (e) {
                e.preventDefault();
                document.querySelectorAll('.menu-link').forEach(l => l.classList.remove('active'));
                this.classList.add('active');

                document.querySelectorAll('.section-content').forEach(sec => sec.classList.remove('active'));
                const sectionId = 'section-' + this.getAttribute('data-section');
                document.getElementById(sectionId).classList.add('active');
                if (sectionId === 'section-user') {
                    fetch('/Admin/QuanLyNguoiDung')
                        .then(res => res.text())
                        .then(html => {
                            document.getElementById('section-user').innerHTML = html;
                        });
                }

                if (sectionId === 'section-khoa') {
                    loadKhoaList();
                }
            });
        });
 
        function loadKhoaList(id = null) {
            let url = '/Admin/DanhSachKhoa';
            if (id) url += `?id=${id}`;

            fetch(url)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('khoa-container').innerHTML = html;
                    attachDeleteKhoaEvents();
                })
                .catch(error => {
                    document.getElementById('khoa-container').innerHTML = '<div class="text-danger">Lỗi tải dữ liệu</div>';
                    console.error(error);
                });
        }

        function attachDeleteKhoaEvents() {
            document.querySelectorAll('.btn-xoa-khoa').forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    const id = this.dataset.id;

                    if (confirm('Bạn có chắc chắn muốn xóa khoa này không?')) {
                        fetch(`/Khoa/Delete?id=${id}`, {
                            method: 'POST'
                        })
                            .then(res => {
                                if (res.ok) {
                                    loadKhoaList();
                                } else {
                                    alert('Xóa thất bại.');
                                }
                            })
                            .catch(err => {
                                console.error('Lỗi xóa khoa:', err);
                                alert('Đã xảy ra lỗi khi xóa.');
                            });
                    }
                });
            });
        }

        document.addEventListener('click', function (e) {
            if (e.target && e.target.classList.contains('btn-them-khoa')) {
                fetch('/Admin/ThemKhoa')
                    .then(response => response.text())
                    .then(html => {
                        document.getElementById('khoa-container').innerHTML = html;
                    })
                    .catch(error => {
                        document.getElementById('khoa-container').innerHTML = '<div class="text-danger">Lỗi tải giao diện thêm khoa</div>';
                        console.error(error);
                    });
            }

            if (e.target && e.target.classList.contains('btn-cancel')) {
                fetch('/Admin/DanhSachKhoa')
                    .then(response => response.text())
                    .then(html => {
                        document.getElementById('khoa-container').innerHTML = html;
                    });
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            loadKhoaList();
        });
    </script>
</body>
</html>
